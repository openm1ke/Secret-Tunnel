 static void *
+udp_route_worker (void *data)
+{
+    UdpRoute *route = data;
+    JNIEnv *env = NULL;
+    int attached = (*java_vm)->AttachCurrentThread (java_vm, &env, NULL) == JNI_OK;
+
+    pthread_mutex_lock (&route->mutex);
+    route->ready = attached ? 1 : -1;
+    pthread_cond_signal (&route->changed);
+    while (attached && !route->stopping) {
+        while (!route->pending && !route->stopping)
+            pthread_cond_wait (&route->changed, &route->mutex);
+        if (route->stopping)
+            break;
+
+        jboolean matches = JNI_FALSE;
+        jbyteArray addresses = (*env)->NewByteArray (env, route->size * 2);
+        if (addresses) {
+            (*env)->SetByteArrayRegion (env, addresses, 0, route->size * 2, route->addresses);
+            if (!(*env)->ExceptionCheck (env))
+                matches = (*env)->CallBooleanMethod (env, route->data->service,
+                    route->data->priority_owner, addresses, route->local_port, route->remote_port);
+            (*env)->DeleteLocalRef (env, addresses);
+        }
+        if ((*env)->ExceptionCheck (env)) {
+            (*env)->ExceptionClear (env);
+            matches = JNI_FALSE;
+        }
+        route->matched = matches;
+        route->pending = 0;
+        pthread_cond_signal (&route->changed);
+    }
+    pthread_mutex_unlock (&route->mutex);
+    if (attached)
+        (*java_vm)->DetachCurrentThread (java_vm);
+    return NULL;
+}
