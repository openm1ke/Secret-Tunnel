+int
+st_priority_udp_port (const struct ip_addr *local, unsigned short local_port,
+                     const struct ip_addr *remote, unsigned short remote_port)
+{
+    UdpRoute *route = udp_route;
+    if (!route || IP_GET_TYPE (local) != IP_GET_TYPE (remote))
+        return 0;
+
+    pthread_mutex_lock (&route->mutex);
+    if (IP_IS_V4 (local)) {
+        route->size = 4;
+        memcpy (route->addresses, &ip_2_ip4 (local)->addr, 4);
+        memcpy (route->addresses + 4, &ip_2_ip4 (remote)->addr, 4);
+    } else {
+        route->size = 16;
+        memcpy (route->addresses, ip_2_ip6 (local)->addr, 16);
+        memcpy (route->addresses + 16, ip_2_ip6 (remote)->addr, 16);
+    }
+    route->local_port = local_port;
+    route->remote_port = remote_port;
+    route->pending = 1;
+    pthread_cond_signal (&route->changed);
+    while (route->pending)
+        pthread_cond_wait (&route->changed, &route->mutex);
+    int port = route->matched ? route->data->priority_port : 0;
+    pthread_mutex_unlock (&route->mutex);
+    return port;
+}
